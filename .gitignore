__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv*
.ehdeps/
.env
.env.*
!.env.example
*.egg-info/
dist/
build/
.DS_Store

# Downloaded data and model weights stay local.
data/**
!data/README.md
*.tfrecord
*.pth
*.pickle

# Downloaded archives (Drive zips) must never be committed.
*.zip
*.tar
*.tar.gz
*.tgz
*.gz
*.7z
*.rar

**/config/paths.yaml
**/artifacts/*
!**/artifacts/.gitkeep
# Graded run outputs must be committed.
!student/artifacts/metrics*.json
!student/artifacts/grade_run*.log
